{
  "manifest_version": 3,
  "name": "PrivateFlix — Private Adult AI Library",
  "short_name": "PrivateFlix",
  "version": "0.4.2",
  "description": "Save and rediscover adult AI characters, prompts, images and videos in one discreet local library.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["https://privateflix-hub.mmgrafisk.chatgpt.site/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:;"
  },
  "action": {
    "default_title": "Save to PrivateFlix",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/privateflix-16.png",
      "32": "icons/privateflix-32.png",
      "48": "icons/privateflix-48.png",
      "128": "icons/privateflix-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open PrivateFlix to save the current page"
    },
    "open-private-library": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open your PrivateFlix library"
    },
    "toggle-privacy-shield": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Toggle the neutral Privacy Shield workspace"
    }
  },
  "icons": {
    "16": "icons/privateflix-16.png",
    "32": "icons/privateflix-32.png",
    "48": "icons/privateflix-48.png",
    "128": "icons/privateflix-128.png"
  }
}
